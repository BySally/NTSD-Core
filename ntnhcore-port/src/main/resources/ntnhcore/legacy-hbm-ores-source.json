  "modern_adaptations": [
    "Ordinary overworld rare-earth ore also covers its new deepslate variant. Gneiss rare-earth ore is retained, as it is not selected by the original rule.",
    "HBM clouds/veins run after cleanup. On planets this is after native Space population; native unwanted ore writes are also filtered to prevent adjacent decoration from reintroducing removed ores.",
    "Existing saved chunks and player-placed blocks are not scanned or retro-generated.",
    "The two ordinary rare-earth vein features are excluded from the native overworld biome modifier; all other native feature entries are retained in their original order. This prevents cross-chunk writes from vanilla OreFeature after a neighbour cleanup."
  ],
  "remaining": [
    "COG cloud noise and Bezier geometry remain approximate.",
    "Native generation not selected by these ten rules is retained.",
    "Lapis and nether quartz cleanup are deferred outside this HBM-only phase.",
    "Full ore economy and survival/reactor/space playthrough remain unverified."
  ],
  "native_features_excluded": [
    "hbm:ore_rare",
    "hbm:ore_rare_deepslate"
  ]
