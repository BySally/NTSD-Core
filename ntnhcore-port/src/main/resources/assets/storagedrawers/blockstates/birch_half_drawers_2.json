{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "storagedrawers:block/birch_half_drawers_2"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "storagedrawers:block/birch_half_drawers_2",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "storagedrawers:block/birch_half_drawers_2",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "storagedrawers:block/birch_half_drawers_2",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "ntnh_sealed": "true"
      },
      "apply": {
        "model": "ntnhcore:block/drawer_tape_half",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "ntnh_sealed": "true"
      },
      "apply": {
        "model": "ntnhcore:block/drawer_tape_half",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "ntnh_sealed": "true"
      },
      "apply": {
        "model": "ntnhcore:block/drawer_tape_half",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "ntnh_sealed": "true"
      },
      "apply": {
        "model": "ntnhcore:block/drawer_tape_half",
        "y": 270
      }
    }
  ]
}
